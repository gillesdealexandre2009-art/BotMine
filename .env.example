# Token do bot (Discord Developer Portal → Bot → Reset Token). NUNCA versionar o .env real.
DISCORD_TOKEN=cole_o_token_aqui

# Caminho do banco. No Railway, com Volume montado em /data:
DATABASE_PATH=/data/kiza.db

# Opcional
# BACKUP_DIR=/data/backups
# BACKUP_RETENCAO=7
# LOG_LEVEL=INFO
# DEV_GUILD_ID=000000000000000000     # sincroniza comandos só nesse servidor (instantâneo)
# COGS_DESATIVADOS=mines,casamento     # módulos que não devem carregar
# ENABLE_MINECRAFT=false               # reservado

# Cérebro da Kiza (IA de conversa). Sem a chave ela usa só as frases fixas.
# Cérebro GRÁTIS (Groq, console.groq.com/keys). Tem prioridade sobre a Anthropic.
# CEREBRO_API_KEY=gsk_...
# Só para desenhos (opcional, Gemini grátis em aistudio.google.com/apikey):
# DESENHO_API_KEY=AIza...
# ANTHROPIC_API_KEY=sk-ant-...
# CEREBRO_MODELO=claude-sonnet-5-5   # padrão; haiku-4-5-20251001 é mais barato e mais fraco

{
  "namespace": "hud",

  "root_panel": {
    "modifications": [
      {
        "array_name": "controls",
        "operation": "insert_back",
        "value": [
          { "vulpus_sidebar@vulpus_hud.sidebar": {} }
        ]
      }
    ]
  },

  "hud_title_text": {
    "modifications": [
      {
        "array_name": "bindings",
        "operation": "insert_back",
        "value": [
          { "binding_name": "#hud_title_text_string" },
          {
            "binding_type": "view",
            "source_property_name": "((#hud_title_text_string - '§v§s§b§r') = #hud_title_text_string)",
            "target_property_name": "#visible"
          }
        ]
      }
    ]
  }
}

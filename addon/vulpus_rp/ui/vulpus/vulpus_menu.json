{
  "namespace": "vulpus_menu",

  "root": {
    "type": "panel",
    "$vp_creme|default": [ 1.0, 0.957, 0.902 ],
    "controls": [
      {
        "hub@vulpus_menu.hub": {
          "bindings": [
            { "binding_name": "#title_text" },
            {
              "binding_type": "view",
              "source_property_name": "(not ((#title_text - '§v§u§l§p§0§r') = #title_text))",
              "target_property_name": "#visible"
            }
          ]
        }
      },
      {
        "lista@vulpus_menu.lista": {
          "bindings": [
            { "binding_name": "#title_text" },
            {
              "binding_type": "view",
              "source_property_name": "((not ((#title_text - '§v§u§l§p') = #title_text)) and ((#title_text - '§v§u§l§p§0§r') = #title_text))",
              "target_property_name": "#visible"
            }
          ]
        }
      }
    ]
  },

  "hub": {
    "type": "panel",
    "size": [ 330, 210 ],
    "layer": 2,
    "$foco_slot_0|default": "vulpus_slot_0",
    "$foco_slot_1|default": "vulpus_slot_1",
    "$foco_slot_2|default": "vulpus_slot_2",
    "$foco_slot_3|default": "vulpus_slot_3",
    "$foco_slot_4|default": "vulpus_slot_4",
    "$foco_slot_5|default": "vulpus_slot_5",
    "$foco_slot_6|default": "vulpus_slot_6",
    "$foco_slot_7|default": "vulpus_slot_7",
    "$foco_slot_8|default": "vulpus_slot_8",
    "$foco_slot_9|default": "vulpus_slot_9",
    "property_bag": { "#visible": false },
    "visible": "#visible",
    "controls": [
      { "quadro@vulpus_menu.quadro": { "$titulo_imagem": true } },
      { "staff@vulpus_menu.area_staff": {} },
      { "corpo@vulpus_menu.corpo_hub": {} }
    ]
  },

  "corpo_hub": {
    "type": "panel",
    "size": [ "100% - 16px", "100% - 32px" ],
    "anchor_from": "top_middle",
    "anchor_to": "top_middle",
    "offset": [ 0, 28 ],
    "controls": [
      {
        "colunas": {
          "type": "stack_panel",
          "orientation": "horizontal",
          "size": [ "100%", 151 ],
          "collection_name": "form_buttons",
          "controls": [
            { "esquerda@vulpus_menu.coluna_esquerda": {} },
            { "margem_esquerda": { "type": "panel", "size": [ 6, "100%" ] } },
            { "centro@vulpus_menu.centro_hub": {} },
            { "margem_direita": { "type": "panel", "size": [ 6, "100%" ] } },
            { "direita@vulpus_menu.coluna_direita": {} }
          ]
        }
      }
    ]
  },

  "coluna_esquerda": {
    "type": "stack_panel",
    "orientation": "vertical",
    "size": [ 92, "100%" ],
    "collection_name": "form_buttons",
    "controls": [
      { "slot_0@vulpus_menu.slot_hub": { "collection_index": 0, "$foco_id": "$foco_slot_0", "$foco_direita": "$foco_slot_5", "$foco_prioridade": 2 } },
      { "espaco_0@vulpus_menu.espaco_slot": {} },
      { "slot_1@vulpus_menu.slot_hub": { "collection_index": 1, "$foco_id": "$foco_slot_1", "$foco_direita": "$foco_slot_6" } },
      { "espaco_1@vulpus_menu.espaco_slot": {} },
      { "slot_2@vulpus_menu.slot_hub": { "collection_index": 2, "$foco_id": "$foco_slot_2", "$foco_direita": "$foco_slot_7" } },
      { "espaco_2@vulpus_menu.espaco_slot": {} },
      { "slot_3@vulpus_menu.slot_hub": { "collection_index": 3, "$foco_id": "$foco_slot_3", "$foco_direita": "$foco_slot_8" } },
      { "espaco_3@vulpus_menu.espaco_slot": {} },
      { "slot_4@vulpus_menu.slot_hub": { "collection_index": 4, "$foco_id": "$foco_slot_4", "$foco_direita": "$foco_slot_9" } }
    ]
  },

  "coluna_direita": {
    "type": "stack_panel",
    "orientation": "vertical",
    "size": [ 92, "100%" ],
    "collection_name": "form_buttons",
    "controls": [
      { "slot_5@vulpus_menu.slot_hub": { "collection_index": 5, "$foco_id": "$foco_slot_5", "$foco_esquerda": "$foco_slot_0" } },
      { "espaco_5@vulpus_menu.espaco_slot": {} },
      { "slot_6@vulpus_menu.slot_hub": { "collection_index": 6, "$foco_id": "$foco_slot_6", "$foco_esquerda": "$foco_slot_1" } },
      { "espaco_6@vulpus_menu.espaco_slot": {} },
      { "slot_7@vulpus_menu.slot_hub": { "collection_index": 7, "$foco_id": "$foco_slot_7", "$foco_esquerda": "$foco_slot_2" } },
      { "espaco_7@vulpus_menu.espaco_slot": {} },
      { "slot_8@vulpus_menu.slot_hub": { "collection_index": 8, "$foco_id": "$foco_slot_8", "$foco_esquerda": "$foco_slot_3" } },
      { "espaco_8@vulpus_menu.espaco_slot": {} },
      { "slot_9@vulpus_menu.slot_hub": { "collection_index": 9, "$foco_id": "$foco_slot_9", "$foco_esquerda": "$foco_slot_4" } }
    ]
  },

  "espaco_slot": { "type": "panel", "size": [ "100%", 4 ] },

  "centro_hub": {
    "type": "stack_panel",
    "orientation": "vertical",
    "size": [ "fill", "100%" ],
    "controls": [
      { "espaco_topo": { "type": "panel", "size": [ "100%", "fill" ] } },
      {
        "logo": {
          "type": "panel",
          "size": [ "100%", 60 ],
          "controls": [
            { "imagem@vulpus_menu.tema_logo": { "size": [ 60, 60 ], "layer": 4 } }
          ]
        }
      },
      { "espaco_logo": { "type": "panel", "size": [ "100%", 4 ] } },
      { "texto@vulpus_menu.texto_hub": {} },
      { "espaco_base": { "type": "panel", "size": [ "100%", "fill" ] } }
    ]
  },

  "texto_hub": {
    "type": "label",
    "text": "#form_text",
    "size": [ "100%", "default" ],
    "max_size": [ "100%", 96 ],
    "text_alignment": "center",
    "color": "$vp_creme",
    "shadow": true,
    "layer": 4,
    "bindings": [ { "binding_name": "#form_text" } ]
  },

  "slot_hub": {
    "type": "panel",
    "size": [ "100%", 27 ],
    "$foco_prioridade|default": 1,
    "controls": [
      {
        "conteudo@vulpus_menu.conteudo_slot": {
          "controls": [
            { "botao@vulpus_menu.botao": {} },
            { "linha@vulpus_menu.linha_botao": { "$max_rotulo": [ "100% - 4px", 25 ] } }
          ]
        }
      }
    ]
  },

  "area_staff": {
    "type": "stack_panel",
    "orientation": "horizontal",
    "size": [ 20, 20 ],
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "offset": [ 6, 4 ],
    "collection_name": "form_buttons",
    "controls": [
      { "slot_10@vulpus_menu.slot_staff": { "collection_index": 10 } }
    ]
  },

  "slot_staff": {
    "type": "panel",
    "size": [ 20, 20 ],
    "controls": [
      {
        "conteudo@vulpus_menu.conteudo_slot": {
          "controls": [
            { "botao@vulpus_menu.botao": {} },
            { "icone@vulpus_menu.icone": { "$tam_icone": [ 16, 16 ], "layer": 4 } }
          ]
        }
      }
    ]
  },

  "lista": {
    "type": "panel",
    "size": [ 270, 220 ],
    "layer": 2,
    "property_bag": { "#visible": false },
    "visible": "#visible",
    "controls": [
      { "quadro@vulpus_menu.quadro": {} },
      {
        "rolagem@common.scrolling_panel": {
          "size": [ "100% - 12px", "100% - 36px" ],
          "offset": [ 0, 30 ],
          "anchor_from": "top_middle",
          "anchor_to": "top_middle",
          "layer": 3,
          "$show_background": false,
          "$scrolling_content": "vulpus_menu.conteudo_lista",
          "$scroll_size": [ 5, "100% - 4px" ],
          "$scrolling_pane_size": [ "100% - 4px", "100% - 2px" ],
          "$scrolling_pane_offset": [ 2, 0 ],
          "$scroll_bar_right_padding_size": [ 0, 0 ]
        }
      }
    ]
  },

  "conteudo_lista": {
    "type": "stack_panel",
    "orientation": "vertical",
    "size": [ "100% - 4px", "100%c" ],
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "controls": [
      { "texto@vulpus_menu.texto_lista": {} },
      { "botoes@vulpus_menu.botoes_lista": {} }
    ]
  },

  "texto_lista": {
    "type": "panel",
    "size": [ "100%", "100%c + 6px" ],
    "bindings": [
      { "binding_name": "#form_text" },
      {
        "binding_type": "view",
        "source_property_name": "(not (#form_text = ''))",
        "target_property_name": "#visible"
      }
    ],
    "controls": [
      {
        "rotulo": {
          "type": "label",
          "text": "#form_text",
          "size": [ "100% - 4px", "default" ],
          "anchor_from": "top_left",
          "anchor_to": "top_left",
          "offset": [ 2, 2 ],
          "text_alignment": "left",
          "color": "$vp_creme",
          "shadow": true,
          "bindings": [ { "binding_name": "#form_text" } ]
        }
      }
    ]
  },

  "botoes_lista": {
    "type": "stack_panel",
    "orientation": "vertical",
    "size": [ "100%", "100%c" ],
    "factory": {
      "name": "buttons",
      "control_ids": {
        "button": "@vulpus_menu.item_lista",
        "label": "@vulpus_menu.rotulo_lista",
        "header": "@vulpus_menu.cabecalho_lista",
        "divider": "@vulpus_menu.divisor_lista"
      },
      "factory_variables": [ "$vp_creme" ]
    },
    "collection_name": "form_buttons",
    "bindings": [
      { "binding_name": "#form_button_contents", "binding_name_override": "#collection_length" }
    ]
  },

  "item_lista": {
    "type": "panel",
    "size": [ "100%", 32 ],
    "controls": [
      {
        "conteudo": {
          "type": "panel",
          "size": [ "100%", 30 ],
          "anchor_from": "top_left",
          "anchor_to": "top_left",
          "controls": [
            { "botao@vulpus_menu.botao": { "$foco_prioridade": 1 } },
            {
              "linha@vulpus_menu.linha_botao": {
                "$tam_icone": [ 20, 20 ],
                "$tam_area_icone": [ 26, "100%" ],
                "$max_rotulo": [ "100% - 4px", 20 ]
              }
            }
          ]
        }
      }
    ]
  },

  "rotulo_lista": {
    "type": "panel",
    "size": [ "100%", "100%c + 4px" ],
    "controls": [
      {
        "texto": {
          "type": "label",
          "text": "#form_button_text",
          "size": [ "100% - 4px", "default" ],
          "anchor_from": "top_left",
          "anchor_to": "top_left",
          "offset": [ 2, 2 ],
          "text_alignment": "left",
          "color": "$vp_creme",
          "shadow": true,
          "bindings": [
            { "binding_name": "#form_button_text", "binding_type": "collection", "binding_collection_name": "form_buttons" }
          ]
        }
      }
    ]
  },

  "cabecalho_lista": {
    "type": "panel",
    "size": [ "100%", "100%c + 8px" ],
    "controls": [
      { "laranja@vulpus_menu.cabecalho_laranja": {} },
      { "black@vulpus_menu.cabecalho_black": {} },
      { "sakura@vulpus_menu.cabecalho_sakura": {} },
      { "lunar@vulpus_menu.cabecalho_lunar": {} },
      { "espirito@vulpus_menu.cabecalho_espirito": {} }
    ]
  },

  "texto_cabecalho": {
    "type": "label",
    "text": "#form_button_text",
    "size": [ "100% - 4px", "default" ],
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "offset": [ 2, 5 ],
    "text_alignment": "left",
    "font_type": "MinecraftTen",
    "backup_font_type": "UIFont",
    "shadow": true,
    "property_bag": { "#visible": false },
    "visible": "#visible"
  },

  "cabecalho_laranja@vulpus_menu.texto_cabecalho": {
    "color": [ 0.949, 0.549, 0.22 ],
    "bindings": [
      { "binding_name": "#form_button_text", "binding_type": "collection", "binding_collection_name": "form_buttons" },
      { "binding_name": "#title_text" },
      {
        "binding_type": "view",
        "source_property_name": "(((((#title_text - '§v§b§r') = #title_text) and ((#title_text - '§v§d§r') = #title_text)) and ((#title_text - '§v§9§r') = #title_text)) and ((#title_text - '§v§5§r') = #title_text))",
        "target_property_name": "#visible"
      }
    ]
  },

  "cabecalho_black@vulpus_menu.texto_cabecalho": {
    "color": [ 0.949, 0.549, 0.22 ],
    "bindings": [
      { "binding_name": "#form_button_text", "binding_type": "collection", "binding_collection_name": "form_buttons" },
      { "binding_name": "#title_text" },
      {
        "binding_type": "view",
        "source_property_name": "(not ((#title_text - '§v§b§r') = #title_text))",
        "target_property_name": "#visible"
      }
    ]
  },

  "cabecalho_sakura@vulpus_menu.texto_cabecalho": {
    "color": [ 1.0, 0.722, 0.839 ],
    "bindings": [
      { "binding_name": "#form_button_text", "binding_type": "collection", "binding_collection_name": "form_buttons" },
      { "binding_name": "#title_text" },
      {
        "binding_type": "view",
        "source_property_name": "(not ((#title_text - '§v§d§r') = #title_text))",
        "target_property_name": "#visible"
      }
    ]
  },

  "cabecalho_lunar@vulpus_menu.texto_cabecalho": {
    "color": [ 0.784, 0.831, 0.922 ],
    "bindings": [
      { "binding_name": "#form_button_text", "binding_type": "collection", "binding_collection_name": "form_buttons" },
      { "binding_name": "#title_text" },
      {
        "binding_type": "view",
        "source_property_name": "(not ((#title_text - '§v§9§r') = #title_text))",
        "target_property_name": "#visible"
      }
    ]
  },

  "cabecalho_espirito@vulpus_menu.texto_cabecalho": {
    "color": [ 0.361, 0.847, 1.0 ],
    "bindings": [
      { "binding_name": "#form_button_text", "binding_type": "collection", "binding_collection_name": "form_buttons" },
      { "binding_name": "#title_text" },
      {
        "binding_type": "view",
        "source_property_name": "(not ((#title_text - '§v§5§r') = #title_text))",
        "target_property_name": "#visible"
      }
    ]
  },

  "divisor_lista": {
    "type": "panel",
    "size": [ "100%", 9 ],
    "controls": [
      { "linha@vulpus_menu.tema_divisor": { "size": [ "100% - 8px", 2 ] } }
    ]
  },

  "quadro": {
    "type": "panel",
    "size": [ "100%", "100%" ],
    "$titulo_imagem|default": false,
    "controls": [
      { "fundo@vulpus_menu.tema_painel": { "layer": 1 } },
      {
        "faixa@vulpus_menu.tema_cabecalho": {
          "size": [ "100% - 4px", 24 ],
          "anchor_from": "top_middle",
          "anchor_to": "top_middle",
          "offset": [ 0, 2 ],
          "layer": 2
        }
      },
      { "titulo@vulpus_menu.titulo": { "ignored": "$titulo_imagem" } },
      {
        "titulo_imagem@vulpus_menu.tema_titulo": {
          "size": [ 97, 21 ],
          "anchor_from": "top_middle",
          "anchor_to": "top_middle",
          "offset": [ 0, 3 ],
          "layer": 6,
          "ignored": "(not $titulo_imagem)"
        }
      },
      { "fechar@vulpus_menu.fechar": {} }
    ]
  },

  "titulo": {
    "type": "label",
    "text": "#text",
    "size": [ "100% - 64px", 10 ],
    "max_size": [ "100% - 64px", 10 ],
    "anchor_from": "top_middle",
    "anchor_to": "top_middle",
    "offset": [ 0, 9 ],
    "text_alignment": "center",
    "font_type": "MinecraftTen",
    "backup_font_type": "UIFont",
    "color": "$vp_creme",
    "shadow": true,
    "layer": 6,
    "bindings": [
      { "binding_name": "#title_text" },
      {
        "binding_type": "view",
        "source_property_name": "(((((((#title_text - '§v§u§l§p§0§r') - '§v§u§l§p§1§r') - '§v§u§l§p') - '§v§b§r') - '§v§d§r') - '§v§9§r') - '§v§5§r')",
        "target_property_name": "#text"
      }
    ]
  },

  "fechar": {
    "type": "button",
    "size": [ 16, 16 ],
    "anchor_from": "top_right",
    "anchor_to": "top_right",
    "offset": [ -6, 6 ],
    "layer": 6,
    "focus_enabled": true,
    "sound_name": "random.click",
    "default_control": "default",
    "hover_control": "hover",
    "pressed_control": "pressed",
    "locked_control": "",
    "button_mappings": [
      { "from_button_id": "button.menu_select", "to_button_id": "button.menu_exit", "mapping_type": "pressed" },
      { "from_button_id": "button.menu_ok", "to_button_id": "button.menu_exit", "mapping_type": "focused" }
    ],
    "controls": [
      { "default@vulpus_menu.tema_fechar": {} },
      { "hover@vulpus_menu.tema_fechar_hover": {} },
      { "pressed@vulpus_menu.tema_fechar_press": {} }
    ]
  },

  "conteudo_slot": {
    "type": "panel",
    "size": [ "100%", "100%" ],
    "bindings": [
      { "binding_name": "#form_button_text", "binding_type": "collection", "binding_collection_name": "form_buttons" },
      {
        "binding_type": "view",
        "source_property_name": "(not (#form_button_text = ''))",
        "target_property_name": "#visible"
      }
    ]
  },

  "botao": {
    "type": "button",
    "size": [ "100%", "100%" ],
    "layer": 3,
    "$foco_id|default": "",
    "$foco_esquerda|default": "",
    "$foco_direita|default": "",
    "$foco_prioridade|default": 0,
    "focus_enabled": true,
    "focus_magnet_enabled": true,
    "focus_identifier": "$foco_id",
    "focus_change_left": "$foco_esquerda",
    "focus_change_right": "$foco_direita",
    "default_focus_precedence": "$foco_prioridade",
    "sound_name": "random.click",
    "default_control": "default",
    "hover_control": "hover",
    "pressed_control": "pressed",
    "locked_control": "",
    "bindings": [
      { "binding_type": "collection_details", "binding_collection_name": "form_buttons" }
    ],
    "button_mappings": [
      { "from_button_id": "button.menu_select", "to_button_id": "button.form_button_click", "mapping_type": "pressed" },
      { "from_button_id": "button.menu_ok", "to_button_id": "button.form_button_click", "mapping_type": "focused" }
    ],
    "controls": [
      { "default@vulpus_menu.tema_botao": {} },
      { "hover@vulpus_menu.tema_botao_hover": {} },
      { "pressed@vulpus_menu.tema_botao_press": {} }
    ]
  },

  "linha_botao": {
    "type": "stack_panel",
    "orientation": "horizontal",
    "size": [ "100%", "100%" ],
    "layer": 4,
    "controls": [
      { "margem": { "type": "panel", "size": [ 4, "100%" ] } },
      { "area_icone@vulpus_menu.area_icone": {} },
      {
        "area_texto": {
          "type": "panel",
          "size": [ "fill", "100%" ],
          "controls": [ { "rotulo@vulpus_menu.rotulo_botao": {} } ]
        }
      }
    ]
  },

  "area_icone": {
    "type": "panel",
    "$tam_area_icone|default": [ 24, "100%" ],
    "size": "$tam_area_icone",
    "bindings": [
      { "binding_name": "#form_button_texture", "binding_type": "collection", "binding_collection_name": "form_buttons" },
      {
        "binding_type": "view",
        "source_property_name": "(not (#form_button_texture = ''))",
        "target_property_name": "#visible"
      }
    ],
    "controls": [ { "icone@vulpus_menu.icone": {} } ]
  },

  "icone": {
    "type": "image",
    "$tam_icone|default": [ 18, 18 ],
    "size": "$tam_icone",
    "bindings": [
      {
        "binding_name": "#form_button_texture",
        "binding_name_override": "#texture",
        "binding_type": "collection",
        "binding_collection_name": "form_buttons"
      },
      {
        "binding_name": "#form_button_texture_file_system",
        "binding_name_override": "#texture_file_system",
        "binding_type": "collection",
        "binding_collection_name": "form_buttons"
      },
      {
        "binding_type": "view",
        "source_property_name": "(not ((#texture = '') or (#texture = 'loading')))",
        "target_property_name": "#visible"
      }
    ]
  },

  "rotulo_botao": {
    "type": "label",
    "text": "#form_button_text",
    "$max_rotulo|default": [ "100% - 4px", 30 ],
    "size": [ "100% - 4px", "default" ],
    "max_size": "$max_rotulo",
    "anchor_from": "left_middle",
    "anchor_to": "left_middle",
    "text_alignment": "left",
    "color": "$vp_creme",
    "shadow": true,
    "bindings": [
      { "binding_name": "#form_button_text", "binding_type": "collection", "binding_collection_name": "form_buttons" }
    ]
  },

  "tema_imagem": {
    "type": "panel",
    "size": [ "100%", "100%" ],
    "controls": [
      { "laranja@vulpus_menu.imagem_laranja": {} },
      { "black@vulpus_menu.imagem_black": {} },
      { "sakura@vulpus_menu.imagem_sakura": {} },
